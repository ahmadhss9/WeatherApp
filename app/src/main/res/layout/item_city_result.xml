<?xml version="1.0" encoding="utf-8"?>
<!-- Step 56: one row of the city search results list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Step 56: "Lahore, Punjab, Pakistan" -->
    <TextView
        android:id="@+id/tvCityName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#172B4D"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Step 56: coordinates, helps tell same-named cities apart -->
    <TextView
        android:id="@+id/tvCityCoords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8493A8"
        android:textSize="12sp" />

</LinearLayout>
